{
  "queries": [
    "Aut0ps technology",
    "software engineering trends",
    "developer tools, hardware, science, and AI"
  ],
  "search_terms": [
    {
      "name": "Aut0ps core search",
      "platform": "google",
      "query": "\"Aut0ps\" OR \"Aut0ps {year}\""
    },
    {
      "name": "September launch season",
      "platform": "google",
      "query": "(\"September launch\" OR \"fall launch\") (technology OR gadgets) after:{start_date}"
    },
    {
      "name": "Apple and flagship launches",
      "platform": "google",
      "query": "(Apple OR iPhone OR iPad OR Mac OR Android OR foldable) (event OR launch OR release) after:{start_date}"
    },
    {
      "name": "IFA announcements",
      "platform": "google",
      "query": "(IFA OR \"IFA {year}\") (smartphone OR laptop OR TV OR AI)"
    },
    {
      "name": "AI agents and computer use",
      "platform": "google",
      "query": "(\"AI agent\" OR agentic OR \"computer use\") (launch OR benchmark OR security) after:{start_date}"
    },
    {
      "name": "Models and benchmarks",
      "platform": "google",
      "query": "(LLM OR \"foundation model\" OR multimodal OR reasoning) (release OR benchmark) after:{start_date}"
    },
    {
      "name": "AI chips and data centers",
      "platform": "google",
      "query": "(\"AI chip\" OR GPU OR TPU OR NPU OR chiplet OR \"custom silicon\" OR \"data center\") (launch OR investment OR pricing) after:{start_date}"
    },
    {
      "name": "Security incidents",
      "platform": "google",
      "query": "(zero-day OR CVE OR ransomware OR \"supply-chain attack\") after:{start_date}"
    },
    {
      "name": "Hardware, mobile, and consumer technology",
      "platform": "google",
      "query": "(smartphone OR laptop OR processor OR camera OR gaming OR wearable OR robotics OR drone) (launch OR review OR release OR benchmark) after:{start_date}"
    },
    {
      "name": "Open source and developer platforms",
      "platform": "google",
      "query": "(\"open source\" OR Linux OR GitHub OR PostgreSQL OR Kubernetes OR browser OR JavaScript) (release OR project OR funding OR security) after:{start_date}"
    },
    {
      "name": "Science, climate, and space technology",
      "platform": "google",
      "query": "(space OR satellite OR climate OR energy OR battery OR biotech OR quantum) (launch OR research OR breakthrough OR investment) after:{start_date}"
    },
    {
      "name": "Telecom, fintech, and digital infrastructure",
      "platform": "google",
      "query": "(telecom OR 5G OR fiber OR fintech OR payments OR broadband OR cloud infrastructure) (launch OR investment OR regulation OR outage) after:{start_date}"
    },
    {
      "name": "Africa and East Africa technology",
      "platform": "google",
      "query": "(Kenya OR Africa OR Nairobi) (AI OR fintech OR telecom OR \"data center\" OR startup) after:{start_date}"
    },
    {
      "name": "Technology conversations on X",
      "platform": "x",
      "query": "(AI OR \"developer tools\" OR cloud) (launch OR release OR funding OR \"open source\") since:{start_date} lang:en"
    },
    {
      "name": "Techmeme on X",
      "platform": "x",
      "query": "from:Techmeme since:{start_date} lang:en"
    },
    {
      "name": "TechCrunch on X",
      "platform": "x",
      "query": "from:TechCrunch since:{start_date} lang:en"
    },
    {
      "name": "Reuters technology on X",
      "platform": "x",
      "query": "from:ReutersTech since:{start_date} lang:en"
    },
    {
      "name": "AI labs on X",
      "platform": "x",
      "query": "(from:OpenAI OR from:AnthropicAI OR from:GoogleDeepMind) since:{start_date} lang:en"
    },
    {
      "name": "Open web technology",
      "platform": "web",
      "query": "technology startup software engineering trends after:{start_date}"
    }
  ],
  "crawl_sites": [
    {
      "name": "Techmeme front page",
      "url": "https://techmeme.com",
      "enabled": true,
      "mode": "scrape",
      "provider": "firecrawl",
      "limit": 1,
      "rss_feeds": ["https://techmeme.com/feed.xml"],
      "notes": "Use the current front page only; the map contains dated archive and fragment URLs."
    },
    {
      "name": "TechCrunch",
      "url": "https://techcrunch.com/",
      "enabled": false,
      "mode": "crawl",
      "provider": "firecrawl",
      "limit": 10,
      "rss_feeds": ["https://techcrunch.com/feed/"],
      "include_paths": ["/category/artificial-intelligence/*", "/category/startups/*", "/category/security/*"],
      "exclude_paths": ["/cdn-cgi/*", "/video/*", "/podcasts/*", "/events/*", "/sitemap*"],
      "max_depth": 1,
